---
import Base from '../../layouts/Base.astro';
import {
  MAX_LUGARES,
  MAX_MENSAGEM,
  lerMensagem,
  listarConvites,
  textoWhatsapp,
  urlConvite,
  urlWhatsapp,
} from '../../lib/convites';
import { lerCodigo } from '../../lib/acesso';
import { LIMITE_EMAILS_DIA, resendConfigurado } from '../../lib/email';

export const prerender = false;

const origem = Astro.url.origin;
const [convites, codigo, mensagem] = await Promise.all([listarConvites(), lerCodigo(), lerMensagem()]);

const ativos = convites.filter((c) => !c.desativado_em);
const lugares = ativos.reduce((n, c) => n + c.lugares, 0);
const enviados = ativos.filter((c) => c.email_enviado_em || c.whatsapp_em).length;
const respondidos = ativos.filter((c) => c.rsvp_id !== null).length;
const confirmadas = ativos.reduce((n, c) => n + (c.pessoas ?? 0), 0);
const porEnviarEmail = ativos.filter((c) => c.email && !c.email_enviado_em).length;

const ok = Astro.url.searchParams.get('ok');
const erro = Astro.url.searchParams.get('erro');
const fmt = new Intl.DateTimeFormat('pt-PT', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Lisbon' });
const data = (iso: string | null) => (iso ? fmt.format(new Date(iso)) : '');
const telVisivel = (t: string) => (t.startsWith('351') && t.length === 12 ? `${t.slice(3, 6)} ${t.slice(6, 9)} ${t.slice(9)}` : `+${t}`);
const exemplo = textoWhatsapp({ nome: 'Família Silva', lugares: 3, mensagem: mensagem.texto, url: `${origem}/c/…` });
const lugaresOpcoes = Array.from({ length: MAX_LUGARES }, (_, i) => i + 1);
---

<Base title="Convidados · Dashboard RSVP Aminah & Luís" noindex>
  <div class="dash">
    <header class="topo">
      <div>
        <p class="sobre">Aminah <span class="e">e</span> Luís · 05.09.2027</p>
        <h1>Convidados</h1>
      </div>
      <nav class="acoes" aria-label="Dashboard">
        <a class="btn btn--linha" href="/dashboard">Respostas</a>
        <form method="post" action="/dashboard/logout"><button class="btn btn--linha" type="submit">Sair</button></form>
      </nav>
    </header>

    {ok && <p class="aviso" role="status">{ok}</p>}
    {erro && <p class="aviso aviso--erro" role="alert">{erro}</p>}

    <section class="kpis" aria-label="Resumo">
      <div class="kpi kpi--destaque">
        <span class="kpi__n">{ativos.length}</span>
        <span class="kpi__l">convites pessoais</span>
        <span class="kpi__s">{lugares} lugares</span>
      </div>
      <div class="kpi">
        <span class="kpi__n">{enviados}</span>
        <span class="kpi__l">enviados</span>
        <span class="kpi__s">por email ou WhatsApp</span>
      </div>
      <div class="kpi">
        <span class="kpi__n">{respondidos}</span>
        <span class="kpi__l">responderam</span>
        <span class="kpi__s">{confirmadas} pessoas confirmadas</span>
      </div>
      <div class="kpi">
        <span class="kpi__n">{ativos.length - respondidos}</span>
        <span class="kpi__l">à espera</span>
      </div>
    </section>

    <div class="grelha">
      <section class="painel" id="codigo">
        <h2>Código do convite impresso</h2>
        {
          codigo ? (
            <>
              <p class="codigo">{codigo}</p>
              <p class="mute">
                Quem abrir <a href={origem}>{origem.replace(/^https?:\/\//, '')}</a> (ex.: pelo QR code) tem de escrever este
                código. Os links pessoais abrem sem código.
              </p>
              <p class="mute">
                Link que já leva o código (para um QR que entra direto):
                <code class="quebra">{`${origem}/?c=${codigo}`}</code>
              </p>
            </>
          ) : (
            <p class="aviso aviso--erro">
              Ainda sem código: o convite está aberto a quem tiver o link. Escolhe o código que vai impresso no convite.
            </p>
          )
        }
        <form method="post" action="/api/admin/convites" class="linha-form">
          <input type="hidden" name="acao" value="codigo" />
          <label class="sr-only" for="novo-codigo">Novo código</label>
          <input
            id="novo-codigo"
            name="codigo"
            type="text"
            placeholder={codigo ? 'Novo código' : 'Ex.: SERRALHEIRA'}
            minlength="4"
            maxlength="24"
            autocomplete="off"
            required
          />
          <button class="btn" type="submit" data-confirmar={codigo ? 'Mudar o código? Quem tem o convite impresso com o código antigo deixa de conseguir entrar.' : undefined}>
            {codigo ? 'Mudar' : 'Guardar'}
          </button>
        </form>
        <p class="mute pequeno">Letras e números; maiúsculas, espaços e acentos não contam.</p>
        {
          codigo && (
            <form method="post" action="/api/admin/convites">
              <input type="hidden" name="acao" value="codigo" />
              <input type="hidden" name="remover" value="1" />
              <button class="link" type="submit" data-confirmar="Remover o código? O convite fica aberto a quem tiver o link.">
                Remover código
              </button>
            </form>
          )
        }
      </section>

      <section class="painel" id="mensagem">
        <h2>Mensagem que acompanha o link</h2>
        <form method="post" action="/api/admin/convites" class="mensagem-form">
          <input type="hidden" name="acao" value="mensagem" />
          <label class="sr-only" for="mensagem-in">Mensagem</label>
          <textarea id="mensagem-in" name="mensagem" rows="4" maxlength={MAX_MENSAGEM}>{mensagem.texto}</textarea>
          <div class="acoes">
            <button class="btn" type="submit">Guardar</button>
            {mensagem.propria && <button class="btn btn--linha" type="submit" name="repor" value="1">Repor sugestão</button>}
          </div>
        </form>
        <p class="mute pequeno">O "Olá, …!", a linha dos lugares e o link juntam-se sozinhos. Exemplo no WhatsApp:</p>
        <pre class="exemplo">{exemplo}</pre>
      </section>
    </div>

    <section class="painel" id="adicionar">
      <h2>Adicionar convidados</h2>
      <p class="mute">
        Um convite por pessoa, casal ou família, com o número de lugares. Cada convite tem o seu link: abre o convite sem
        código e serve também para alterar a resposta. Email e telefone são opcionais (para enviar daqui).
      </p>
      <form method="post" action="/api/admin/convites" id="form-adicionar">
        <input type="hidden" name="acao" value="adicionar" />
        <div class="linhas">
          <div class="linha linha--cab" aria-hidden="true">
            <span>Nome no convite</span><span>Lugares</span><span>Email</span><span>Telemóvel</span>
          </div>
          <div class="linha">
            <input name="nome" type="text" maxlength="120" placeholder="Ex.: Família Silva" aria-label="Nome no convite" />
            <select name="lugares" aria-label="Lugares">
              {lugaresOpcoes.map((n) => <option value={n} selected={n === 2}>{n}</option>)}
            </select>
            <input name="email" type="email" maxlength="200" placeholder="opcional" aria-label="Email" />
            <input name="telefone" type="tel" maxlength="20" placeholder="opcional" aria-label="Telemóvel" />
          </div>
        </div>
        <div class="acoes">
          <button class="btn btn--linha" type="button" id="mais-linha">+ Outro convidado</button>
          <button class="btn" type="submit">Adicionar</button>
        </div>
      </form>
    </section>

    <section class="painel" id="lista">
      <div class="tabela-topo">
        <h2>Convites</h2>
        <div class="acoes">
          <input type="search" id="filtro" placeholder="Procurar nome…" aria-label="Procurar convite" />
          {
            porEnviarEmail > 0 && (
              <form method="post" action="/api/admin/convites">
                <input type="hidden" name="acao" value="enviar-email" />
                <button
                  class="btn"
                  type="submit"
                  data-confirmar={`Enviar o convite por email a ${porEnviarEmail} ${porEnviarEmail === 1 ? 'pessoa' : 'pessoas'}?`}
                >
                  Enviar email a quem falta ({porEnviarEmail})
                </button>
              </form>
            )
          }
        </div>
      </div>
      {
        !resendConfigurado() && (
          <p class="mute pequeno">
            Sem RESEND_API_KEY: os emails ficam marcados como enviados mas não saem (útil para testar em local).
          </p>
        )
      }
      <p class="mute pequeno">Máximo de {LIMITE_EMAILS_DIA} emails por dia (plano gratuito do Resend).</p>
      {
        convites.length === 0 ? (
          <p class="vazio">Ainda sem convites pessoais.</p>
        ) : (
          <div class="tabela-wrap">
            <table>
              <thead>
                <tr>
                  <th>Convite</th>
                  <th>Contactos</th>
                  <th>Enviado</th>
                  <th>Resposta</th>
                  <th>
                    <span class="sr-only">Ações</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {convites.map((c) => {
                  const link = urlConvite(origem, c.id);
                  const wa = urlWhatsapp(textoWhatsapp({ nome: c.nome, lugares: c.lugares, mensagem: mensagem.texto, url: link }), c.telefone);
                  return (
                    <tr data-nome={c.nome.toLowerCase()} class={c.desativado_em ? 'desativado' : ''}>
                      <td data-l="Convite">
                        <b>{c.nome}</b>
                        <span class="mute"> · {c.lugares} {c.lugares === 1 ? 'lugar' : 'lugares'}</span>
                        {c.desativado_em && <span class="tag tag--nao">desativado</span>}
                      </td>
                      <td data-l="Contactos" class={c.email || c.telefone ? '' : 'mute'}>
                        {c.email && <div class="quebra">{c.email}</div>}
                        {c.telefone && <div>{telVisivel(c.telefone)}</div>}
                        {!c.email && !c.telefone && '—'}
                      </td>
                      <td data-l="Enviado" class="mute">
                        {c.email_enviado_em && <div>Email · {data(c.email_enviado_em)}</div>}
                        {c.whatsapp_em && <div>WhatsApp · {data(c.whatsapp_em)}</div>}
                        {!c.email_enviado_em && !c.whatsapp_em && '—'}
                      </td>
                      <td data-l="Resposta">
                        {c.rsvp_id === null ? (
                          <span class="tag">à espera</span>
                        ) : c.vai ? (
                          <span class="tag tag--sim">
                            vai · {c.pessoas} de {c.lugares}
                          </span>
                        ) : (
                          <span class="tag tag--nao">não vai</span>
                        )}
                      </td>
                      <td class="botoes">
                        {!c.desativado_em && (
                          <>
                            {c.email && (
                              <form method="post" action="/api/admin/convites">
                                <input type="hidden" name="acao" value="enviar-email" />
                                <input type="hidden" name="id" value={c.id} />
                                <button class="btn btn--peq" type="submit">
                                  {c.email_enviado_em ? 'Reenviar email' : 'Email'}
                                </button>
                              </form>
                            )}
                            {c.telefone && (
                              <a class="btn btn--peq whatsapp" href={wa} target="_blank" rel="noopener" data-id={c.id}>
                                WhatsApp
                              </a>
                            )}
                            <button class="btn btn--peq btn--linha copiar" type="button" data-link={link} data-texto={textoWhatsapp({ nome: c.nome, lugares: c.lugares, mensagem: mensagem.texto, url: link })}>
                              Copiar link
                            </button>
                          </>
                        )}
                        <details class="mais">
                          <summary>Mais</summary>
                          <div class="mais__caixa">
                            <form method="post" action="/api/admin/convites" class="editar">
                              <input type="hidden" name="acao" value="editar" />
                              <input type="hidden" name="id" value={c.id} />
                              <label>
                                Nome <input name="nome" type="text" value={c.nome} maxlength="120" required />
                              </label>
                              <label>
                                Lugares
                                <select name="lugares">
                                  {lugaresOpcoes.map((n) => <option value={n} selected={n === c.lugares}>{n}</option>)}
                                </select>
                              </label>
                              <label>
                                Email <input name="email" type="email" value={c.email ?? ''} maxlength="200" />
                              </label>
                              <label>
                                Telemóvel <input name="telefone" type="tel" value={c.telefone ? `+${c.telefone}` : ''} maxlength="20" />
                              </label>
                              <button class="btn btn--peq" type="submit">Guardar</button>
                            </form>
                            <div class="mais__acoes">
                              <a href={link} target="_blank" rel="noopener noreferrer">Abrir o convite</a>
                              <button type="button" class="link link--verde copiar-texto" data-texto={textoWhatsapp({ nome: c.nome, lugares: c.lugares, mensagem: mensagem.texto, url: link })}>
                                Copiar mensagem
                              </button>
                              <form method="post" action="/api/admin/convites">
                                <input type="hidden" name="acao" value={c.desativado_em ? 'ativar' : 'desativar'} />
                                <input type="hidden" name="id" value={c.id} />
                                <button class="link link--verde" type="submit">
                                  {c.desativado_em ? 'Ativar o link' : 'Desativar o link'}
                                </button>
                              </form>
                              <form method="post" action="/api/admin/convites">
                                <input type="hidden" name="acao" value="apagar" />
                                <input type="hidden" name="id" value={c.id} />
                                <button class="link" type="submit" data-confirmar={`Apagar o convite de ${c.nome}? O link deixa de funcionar.`}>
                                  Apagar
                                </button>
                              </form>
                            </div>
                          </div>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</Base>

<script>
  // Confirmações antes de ações que não dá para desfazer.
  document.addEventListener('submit', (e) => {
    const b = (e as SubmitEvent).submitter as HTMLElement | null;
    const msg = b?.dataset.confirmar;
    if (msg && !confirm(msg)) e.preventDefault();
  });

  // Mais uma linha no "Adicionar convidados".
  const linhas = document.querySelector<HTMLDivElement>('#form-adicionar .linhas');
  document.querySelector('#mais-linha')?.addEventListener('click', () => {
    if (!linhas || linhas.children.length > 100) return;
    const modelo = linhas.querySelector<HTMLDivElement>('.linha:not(.linha--cab)')!;
    const nova = modelo.cloneNode(true) as HTMLDivElement;
    nova.querySelectorAll('input').forEach((i) => (i.value = ''));
    nova.querySelector('select')!.value = '2';
    linhas.appendChild(nova);
    nova.querySelector('input')!.focus();
  });

  // Copiar link ou mensagem.
  async function copiar(b: HTMLButtonElement, texto: string) {
    const antes = b.textContent;
    try {
      await navigator.clipboard.writeText(texto);
      b.textContent = 'Copiado!';
    } catch {
      prompt('Copia:', texto);
    }
    setTimeout(() => (b.textContent = antes), 2000);
  }
  document.querySelectorAll<HTMLButtonElement>('.copiar').forEach((b) =>
    b.addEventListener('click', () => copiar(b, b.dataset.link!)),
  );
  document.querySelectorAll<HTMLButtonElement>('.copiar-texto').forEach((b) =>
    b.addEventListener('click', () => copiar(b, b.dataset.texto!)),
  );

  // WhatsApp: abre a conversa já escrita e regista em segundo plano que foi aberta.
  document.querySelectorAll<HTMLAnchorElement>('a.whatsapp').forEach((a) =>
    a.addEventListener('click', () => {
      const body = new FormData();
      body.set('acao', 'whatsapp');
      body.set('id', a.dataset.id!);
      fetch('/api/admin/convites', { method: 'POST', body, keepalive: true });
    }),
  );

  const filtro = document.querySelector<HTMLInputElement>('#filtro');
  filtro?.addEventListener('input', () => {
    const q = filtro.value.trim().toLowerCase();
    document.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((tr) => {
      tr.hidden = !!q && !(tr.dataset.nome ?? '').includes(q);
    });
  });
</script>

<style>
  :global(body) {
    background: #f6efe3;
  }
  .dash {
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 16px 64px;
    color: var(--verde);
  }
  .topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .sobre {
    margin: 0;
    font-family: var(--f-caps);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    color: var(--oliva);
  }
  .e {
    font-family: var(--f-script);
    text-transform: none;
    font-size: 1.4em;
  }
  h1 {
    font-family: var(--f-titulo);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    line-height: 1.05;
    margin: 4px 0 0;
  }
  h2 {
    font-family: var(--f-caps);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.95rem;
    margin: 0 0 14px;
  }
  .acoes {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  form {
    margin: 0;
  }
  .btn {
    display: inline-block;
    font-family: var(--f-caps);
    font-size: 0.95rem;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--verde);
    background: var(--verde);
    color: var(--bege);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn--linha {
    background: transparent;
    color: var(--verde);
  }
  .btn--peq {
    font-size: 0.82rem;
    padding: 6px 12px;
  }
  .aviso {
    background: var(--azul);
    padding: 10px 14px;
    border-radius: 8px;
  }
  .aviso--erro {
    background: #f6e3cf;
    color: #7a3d12;
  }
  .kpis {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }
  .kpi {
    background: #fff;
    border-radius: 12px;
    padding: 16px 18px;
    display: grid;
    align-content: start;
    gap: 2px;
  }
  .kpi--destaque {
    background: var(--verde);
    color: var(--bege);
  }
  .kpi__n {
    font-family: var(--f-titulo);
    font-variation-settings: 'opsz' 100;
    font-size: 3rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .kpi__l {
    font-family: var(--f-caps);
    font-size: 0.95rem;
  }
  .kpi__s {
    font-size: 0.82rem;
    opacity: 0.75;
  }
  .grelha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .painel {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    min-width: 0;
    margin-bottom: 16px;
  }
  .grelha .painel {
    margin-bottom: 0;
  }
  .painel > p {
    margin: 0 0 12px;
  }
  .vazio,
  .mute {
    color: #8a8670;
  }
  .pequeno {
    font-size: 0.85rem;
  }
  .codigo {
    font-family: var(--f-caps);
    font-size: 2rem;
    letter-spacing: 0.18em;
    margin: 0 0 8px !important;
  }
  code {
    font-size: 0.85rem;
    background: #f4f1ea;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .quebra {
    word-break: break-all;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 0.95rem;
    padding: 9px 11px;

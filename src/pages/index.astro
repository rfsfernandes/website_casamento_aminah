---
import Convite from '../components/Convite.astro';
import { codigoCerto, darAcesso, temAcesso } from '../lib/acesso';
import { ipDe, permitir } from '../lib/seguranca';

// Servido pelo Worker (não é estático): o convite só aparece a quem tem o código.
export const prerender = false;

// Link com o código incluído (ex.: um QR code que já leva ?c=CODIGO): entra e limpa o endereço.
const c = Astro.url.searchParams.get('c');
if (c && (await permitir(`codigo:${ipDe(Astro.request)}`, 8, 60)) && (await codigoCerto(c))) {
  await darAcesso(Astro.cookies, Astro.url);
  return Astro.redirect('/', 303);
}

const acesso = await temAcesso(Astro.cookies);
const erro = Astro.url.searchParams.get('codigo');
const erroCodigo =
  erro === 'errado' || c
    ? 'Esse código não está certo. Confirma no convite e tenta outra vez.'
    : erro === 'espera'
      ? 'Muitas tentativas seguidas. Espera um minuto e tenta outra vez.'
      : null;

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Convite modo={acesso ? 'convite' : 'portao'} erroCodigo={erroCodigo} />

---
import Base from '../layouts/Base.astro';
import { IDADES, MAX_ACOMPANHANTES, RSVP_FECHA_EM } from '../lib/rsvp';
import type { Rsvp } from '../lib/db';

/**
 * O convite (design do Canva). O mesmo componente serve:
 * - `convite`: o convite completo, com o formulário (vazio, ou preenchido para alterar a resposta);
 * - `portao`: só a capa e o campo para o código impresso no convite.
 */
interface Props {
  modo: 'convite' | 'portao';
  /** Link de alteração (/r/<token>) que o convidado recebe ao responder. */
  edicao?: string | null;
  /** Resposta já dada, para preencher o formulário. */
  resposta?: Rsvp | null;
  erroCodigo?: string | null;
  noindex?: boolean;
}
const { modo, edicao = null, resposta = null, erroCodigo = null, noindex = false } = Astro.props;

const maxAcomp = Math.max(MAX_ACOMPANHANTES, resposta?.acompanhantes ?? 0);
const numAcomp = Array.from({ length: maxAcomp + 1 }, (_, i) => i);
const acomps = numAcomp.slice(1);

// Preenchimento a partir da resposta já dada.
const vaiInicial = resposta ? (resposta.vai ? 'sim' : 'nao') : null;
const nAcompInicial = resposta?.vai ? resposta.acompanhantes : 0;
const pessoa = (i: number) => (resposta?.vai ? resposta.pessoas.find((p) => p.ordem === i) : undefined);
const restricaoInicial = (i: number) => {
  const p = pessoa(i);
  return p?.restricao === 1 ? 'sim' : p?.restricao === 0 ? 'nao' : null;
};
const nomeInicial = resposta?.nome ?? '';
const aEditar = !!edicao;

const fotos = Array.from({ length: 12 }, (_, i) => `/img/foto-${String(i + 1).padStart(2, '0')}.webp`);

const programa = [
  ['15h15', 'Chegada dos convidados'],
  ['16h', 'Cerimónia'],
  ['16h30', 'Cocktail'],
  ['18h', 'Jantar'],
  ['22h', 'Corte do bolo'],
  ['22h30', 'Festa'],
];

const mapa = 'https://www.google.com/maps/search/?api=1&query=Quinta+da+Serralheira+Palmela';
---

<Base
  title="Aminah & Luís · 5 de setembro de 2027"
  description="Vamos celebrar o nosso casamento. 5 de setembro de 2027, Quinta da Serralheira, Palmela."
  noindex={noindex}
>
  <!-- ============ CAPA ============ -->
  <header class="hero">
    <div class="hero__inner">
      <div class="hero__nomes">
        <h1 class="nomes">
          <span class="nome">Aminah</span>
          <span class="linha2"><span class="e" aria-label="e">e</span><span class="nome">Luís</span></span>
        </h1>
        <p class="convite">Vamos celebrar o nosso casamento</p>
        <div class="quando">
          <p><time datetime="2027-09-05">5 Setembro<br />2027</time></p>
          <span class="divisor" aria-hidden="true"></span>
          <p>Quinta da<br />Serralheira</p>
        </div>
      </div>
      <div class="hero__arte">
        <img src="/img/hero-quinta.webp" width="974" height="677" alt="" fetchpriority="high" />
        <a class="rsvp-link" href={modo === 'portao' ? '#codigo' : '#rsvp'}>RSVP</a>
      </div>
    </div>
  </header>

  {
    modo !== 'convite' && (
      <main>
        <section class="info info--so-cartao" aria-label="Abrir o convite">
          <div class="cartao-form" id="codigo">
              <form class="form" method="post" action="/api/codigo">
                <div class="campo">
                  <label for="codigo-in">Código do convite</label>
                  <input
                    id="codigo-in"
                    class="codigo-in"
                    name="codigo"
                    type="text"
                    autocomplete="off"
                    autocapitalize="characters"
                    spellcheck="false"
                    required
                    maxlength="40"
                    aria-describedby="codigo-dica"
                  />
                  <p class="dica" id="codigo-dica">
                    Está no convite que recebeste, junto ao QR code.
                  </p>
                </div>
                {erroCodigo && (
                  <p class="erro" role="alert">
                    {erroCodigo}
                  </p>
                )}
                <button type="submit" class="botao">Abrir o convite</button>
              </form>
          </div>
        </section>
      </main>
    )
  }

  {modo === 'convite' && <main>
    <!-- ============ A NOSSA HISTÓRIA ============ -->
    <section class="historia" aria-labelledby="t-historia">
      <img class="ornamento" src="/img/ornament.webp" width="1127" height="316" alt="" />
      <h2 id="t-historia" class="titulo">A nossa história</h2>
      <div class="historia__texto">
        <p>
          Tudo começou ainda adolescentes, nasceu de uma amizade que, sem sabermos, viria a transformar-se numa
          história de amor. Desde os 18 anos, crescemos juntos, partilhámos sonhos, construímos memórias, e
          aprendemos que o amor é também amizade, é estar presente em todos os momentos.
        </p>
        <p>
          Pelo caminho, construímos uma casa, uma família e recebemos o maior presente das nossas vidas, a nossa
          Matilde.
        </p>
        <p>
          Hoje já tantos anos depois do começo desta história, continuamos a escolher-nos todos os dias. E é com a
          mesma alegria, amizade e amor que queremos celebrar este novo capítulo, junto daqueles que fazem parte da
          nossa história.
        </p>
      </div>
    </section>

    <!-- ============ FOTOGRAFIAS ============ -->
    <section class="fotos" aria-label="Fotografias de Aminah e Luís">
      <ul class="fotos__grelha">
        {
          fotos.map((src, i) => (
            <li class="reveal" style={`--d:${(i % 4) * 70}ms`}>
              <img src={src} width="435" height="621" alt={`Aminah e Luís, fotografia ${i + 1}`} loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ O CASAMENTO ============ -->
    <section class="casamento" aria-labelledby="t-casamento">
      <h2 id="t-casamento" class="titulo">O Casamento</h2>
      <div class="cartoes">
        <article class="cartao reveal">
          <img src="/img/quinta.webp" width="729" height="510" alt="Entrada da Quinta da Serralheira" loading="lazy" />
          <h3>A Quinta</h3>
          <p>
            Quinta da Serralheira<br />
            <a href={mapa} target="_blank" rel="noopener">Estrada das Serralheiras<br />Palmela</a>
          </p>
        </article>
        <article class="cartao reveal" style="--d:90ms">
          <img src="/img/alojamento.webp" width="729" height="510" alt="Quarto com cama e dossel branco" loading="lazy" />
          <h3>Alojamento</h3>
          <p>
            (sugestões perto)<br />
            Pousada Castelo de Palmela<br />
            Y Palmela - Boutique Apartments<br />
            Novotel Setúbal
          </p>
        </article>
        <article class="cartao reveal" style="--d:180ms">
          <img src="/img/dresscode.webp" width="729" height="510" alt="Ilustração de convidados vestidos para um casamento" loading="lazy" />
          <h3>Dress code</h3>
          <p>
            Sintam-se livres para escolher o que quiserem e com o que se sintam melhor. <u
              >Temos apenas um pedido às nossas convidadas:</u
            > evitem o verde, uma vez que está reservado para a madrinha e as damas de honor da noiva.
          </p>
        </article>
      </div>
    </section>

    <!-- ============ PROGRAMA ============ -->
    <section class="programa" aria-labelledby="t-programa">
      <div class="programa__inner">
        <div>
          <h2 id="t-programa" class="titulo">Programa do dia</h2>
          <ol class="programa__lista">
            {
              programa.map(([hora, evento]) => (
                <li>
                  <span class="hora">{hora}</span> {evento}
                </li>
              ))
            }
          </ol>
          <p class="nota">*Pode sofrer algumas alterações (excluindo o início da cerimónia)</p>
        </div>
        <div class="doodles" aria-hidden="true">
          <img src="/img/doodle-1.webp" width="313" height="266" alt="" loading="lazy" />
          <img src="/img/doodle-2.webp" width="475" height="321" alt="" loading="lazy" />
          <img src="/img/doodle-3.webp" width="331" height="268" alt="" loading="lazy" />
          <img src="/img/doodle-4.webp" width="290" height="370" alt="" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ============ INFORMAÇÕES + RSVP ============ -->
    <section class="info" aria-labelledby="t-info">
      <div class="info__topo">
        <div>
          <h2 id="t-info" class="titulo">Informações</h2>
          <h3 class="contactos-t">Contactos</h3>
          <p class="contactos">
            Aminah: <a href="tel:+351917621541">917 621 541</a><br />
            Luís: <a href="tel:+351911815228">911 815 228</a>
          </p>
        </div>
        <img class="brinde" src="/img/brinde.webp" width="647" height="614" alt="" loading="lazy" />
      </div>

      <div
        class="cartao-form"
        id="rsvp"
        data-editar={aEditar ? '1' : undefined}
      >
        {
          resposta && (
            <div class="ola">
              <p class="ola__s ola__ja">Já recebemos a resposta. Podes alterá-la aqui até 15 de julho de 2027.</p>
            </div>
          )
        }
        <form class="form" id="rsvp-form" method="post" action="/api/rsvp" novalidate>
          <h3 class="sr-only">Confirmar presença</h3>
          {edicao && <input type="hidden" name="edicao" value={edicao} />}
          <div class="campo">
            <label for="nome">O teu nome</label>
            <input
              id="nome"
              name="nome"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="120"
              value={nomeInicial}
            />
          </div>

          <fieldset class="campo">
            <legend>Contamos contigo?</legend>
            <label class="opcao">
              <input type="radio" name="presenca" value="sim" required checked={vaiInicial === 'sim'} />
              <span>Claro que sim!!!</span>
            </label>
            <label class="opcao">
              <input type="radio" name="presenca" value="nao" checked={vaiInicial === 'nao'} />
              <span>Infelizmente não vou.</span>
            </label>
          </fieldset>

          <div class="so-se-vai revela">
            <fieldset class="campo" data-restricao="0">
              <legend>Tens alguma restrição alimentar?</legend>
              <div class="pilulas">
                <label class="pilula"
                  ><input type="radio" name="restricao_0" value="nao" checked={restricaoInicial(0) === 'nao'} /><span
                    >Não</span
                  ></label
                >
                <label class="pilula"
                  ><input type="radio" name="restricao_0" value="sim" checked={restricaoInicial(0) === 'sim'} /><span
                    >Sim</span
                  ></label
                >
              </div>
              <div class="revela qual-wrap">
                <input
                  class="qual"
                  type="text"
                  name="restricao_0_qual"
                  maxlength="300"
                  placeholder="Se sim, qual? (ex.: vegetariano, sem glúten)"
                  aria-label="Qual é a tua restrição alimentar?"
                  value={pessoa(0)?.restricao_qual ?? ''}
                />
              </div>
            </fieldset>

            {
              maxAcomp === 0 ? (
                <input type="hidden" name="acompanhantes" value="0" />
              ) : (
                <fieldset class="campo">
                  <legend>Quantos acompanhantes trazes?</legend>
                  <div class="pilulas">
                    {numAcomp.map((n) => (
                      <label class="pilula">
                        <input type="radio" name="acompanhantes" value={n} checked={n === nAcompInicial} />
                        <span>{n === 0 ? 'Nenhum' : n}</span>
                      </label>
                    ))}
                  </div>
                  <p class="nota-sem-js">Preenche só os acompanhantes que escolheste acima.</p>
                </fieldset>
              )
            }

            {
              acomps.map((i) => (
                <div class="revela" data-acomp={i}>
                <div class="acomp" role="group" aria-labelledby={`acomp-${i}-t`}>
                  <p class="acomp__t" id={`acomp-${i}-t`}>
                    Acompanhante {i}
                  </p>
                  <div class="acomp__linha">
                    <div class="campo">
                      <label for={`acomp_${i}_nome`}>Nome</label>
                      <input
                        id={`acomp_${i}_nome`}
                        name={`acomp_${i}_nome`}
                        type="text"
                        autocomplete="off"
                        maxlength="120"
                        value={pessoa(i)?.nome ?? ''}
                      />
                    </div>
                    <div class="campo">
                      <label for={`acomp_${i}_idade`}>Idade</label>
                      <select id={`acomp_${i}_idade`} name={`acomp_${i}_idade`}>
                        <option value="" selected={!pessoa(i)?.idade} disabled>
                          Escolhe…
                        </option>
                        {IDADES.map((idade) => (
                          <option value={idade.id} selected={pessoa(i)?.idade === idade.id}>
                            {idade.label}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                  <fieldset class="campo" data-restricao={i}>
                    <legend>Tem alguma restrição alimentar?</legend>
                    <div class="pilulas">
                      <label class="pilula">
                        <input type="radio" name={`restricao_${i}`} value="nao" checked={restricaoInicial(i) === 'nao'} />
                        <span>Não</span>
                      </label>
                      <label class="pilula">
                        <input type="radio" name={`restricao_${i}`} value="sim" checked={restricaoInicial(i) === 'sim'} />
                        <span>Sim</span>
                      </label>
                    </div>
                    <div class="revela qual-wrap">
                      <input
                        class="qual"
                        type="text"
                        name={`restricao_${i}_qual`}
                        maxlength="300"
                        placeholder="Se sim, qual?"
                        aria-label={`Qual é a restrição alimentar do acompanhante ${i}?`}
                        value={pessoa(i)?.restricao_qual ?? ''}
                      />
                    </div>
                  </fieldset>
                </div>
                </div>
              ))
            }
          </div>

          <div class="campo">
            <label for="email">O teu email <span class="opcional">(opcional)</span></label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="200"
              value={resposta?.email ?? ''}
              aria-describedby="email-dica"
            />
            <p class="dica" id="email-dica">Enviamos-te uma cópia da resposta e o link para a alterares.</p>
          </div>

          <div class="armadilha" aria-hidden="true">
            <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p class="erro" role="alert" hidden></p>
          <button type="submit" class="botao">{resposta ? 'Guardar alterações' : 'Confirmar'}</button>
        </form>

        {
          resposta && (
            <form class="apagar-resp" method="post" action="/api/apagar-resposta">
              {edicao && <input type="hidden" name="edicao" value={edicao} />}
              <button type="submit" class="link-btn">
                Apagar a minha resposta
              </button>
            </form>
          )
        }

        <div class="obrigado" role="status" tabindex="-1" hidden>
          <p class="obrigado__t"></p>
          <p class="obrigado__s"></p>
          <div class="guardar-link" hidden>
            <p>Guarda este link para veres ou alterares a resposta mais tarde:</p>
            <p class="guardar-link__linha">
              <a class="guardar-link__url" href="#"></a>
              <button type="button" class="link-btn copiar">Copiar</button>
            </p>
          </div>
          <button type="button" class="link-btn outra">{aEditar ? 'Alterar a resposta' : 'Enviar outra resposta'}</button>
        </div>

        <div class="fechado">
          <p class="obrigado__t">As confirmações estão encerradas</p>
          <p class="obrigado__s">
            O prazo para confirmar presença terminou a 15 de julho de 2027.
            Se precisares de falar connosco, liga à <a href="tel:+351917621541">Aminah</a> ou ao <a href="tel:+351911815228">Luís</a>.
          </p>
        </div>

        <p class="prazo">
          Confirmem, por favor, a <u>vossa presença até ao dia 15 de Julho de 2027</u>
        </p>
      </div>
      <!-- Corre logo (antes de a página aparecer) para não mostrar o formulário por um instante depois do prazo. -->
      <script is:inline define:vars={{ fechaEm: RSVP_FECHA_EM }}>
        if (Date.now() >= Date.parse(fechaEm)) document.getElementById('rsvp').classList.add('rsvp-fechado');
      </script>
    </section>
  </main>}

  <footer class="rodape">
    <p>Aminah <span class="e">e</span> Luís · 05.09.2027</p>
  </footer>
</Base>

<script>
  // Envio do RSVP sem sair da página (o formulário também funciona sem JavaScript).
  // Na página do código (portão) não há formulário de resposta: só corre a animação do fim.
  const formRsvp = document.querySelector<HTMLFormElement>('#rsvp-form');
  if (formRsvp) iniciarRsvp(formRsvp);

  function iniciarRsvp(form: HTMLFormElement) {
  const cartao = document.getElementById('rsvp')!;
  const erro = form.querySelector<HTMLParagraphElement>('.erro')!;
  const botao = form.querySelector<HTMLButtonElement>('.botao')!;
  const textoBotao = botao.textContent!;
  const soSeVai = form.querySelector<HTMLDivElement>('.so-se-vai')!;
  const obrigado = cartao.querySelector<HTMLDivElement>('.obrigado')!;
  const guardarLink = obrigado.querySelector<HTMLDivElement>('.guardar-link')!;
  const apagarForm = cartao.querySelector<HTMLFormElement>('.apagar-resp');
  const ola = cartao.querySelector<HTMLDivElement>('.ola');

  const msgs = {
    sim: ['Obrigado, {nome}!', 'Mal podemos esperar por celebrar contigo.'],
    grupo: ['Obrigado, {nome}!', 'Contamos convosco: {n} pessoas. Mal podemos esperar por celebrar juntos.'],
    nao: ['Obrigado por nos avisares, {nome}.', 'Vamos sentir a tua falta!'],
  };

  function mostrarObrigado(vai: boolean, nome: string, pessoas = 1, alterada = false) {
    const [t, s] = msgs[!vai ? 'nao' : pessoas > 1 ? 'grupo' : 'sim'];
    const titulo = alterada ? 'Resposta atualizada, {nome}!' : t;
    obrigado.querySelector('.obrigado__t')!.textContent = titulo.replace('{nome}', nome.split(' ')[0] || '');
    obrigado.querySelector('.obrigado__s')!.textContent = s.replace('{n}', String(pessoas));
    form.hidden = true;
    if (apagarForm) apagarForm.hidden = true;
    if (ola) ola.hidden = true;
    obrigado.hidden = false;
    obrigado.focus?.();
  }

  /** Quem respondeu com o código recebe um link para alterar: mostra-o e passa a página para modo "alterar". */
  function mostrarLink(url: string) {
    const a = guardarLink.querySelector<HTMLAnchorElement>('.guardar-link__url')!;
    a.href = url;
    a.textContent = url;
    guardarLink.hidden = false;
    const token = new URL(url).pathname.split('/').pop()!;
    let campo = form.querySelector<HTMLInputElement>('input[name=edicao]');
    if (!campo) {
      campo = Object.assign(document.createElement('input'), { type: 'hidden', name: 'edicao' });
      form.insertBefore(campo, form.firstChild);
    }
    campo.value = token;
    cartao.dataset.editar = '1';
    obrigado.querySelector('.outra')!.textContent = 'Alterar a resposta';
    history.replaceState(null, '', new URL(url).pathname + '#rsvp');
  }

  guardarLink.querySelector('.copiar')!.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(guardarLink.querySelector('a')!.href);
      b.textContent = 'Copiado!';
    } catch {
      b.textContent = 'Copia o link acima';
    }
    setTimeout(() => (b.textContent = 'Copiar'), 2500);
  });

  apagarForm?.addEventListener('submit', (e) => {
    if (!confirm('Apagar a tua resposta? A Aminah e o Luís deixam de contar com ela.')) e.preventDefault();
  });

  const acompBlocos = [...form.querySelectorAll<HTMLDivElement>('[data-acomp]')];
  document.documentElement.classList.add('js');

  const semAnimacao = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Mostra ou esconde um bloco a deslizar (altura + opacidade), em vez de aparecer de repente.
   * Também anima o espaço (gap) da grelha onde está, para o resto do formulário não saltar.
   */
  function revelar(el: HTMLElement, mostrar: boolean, animar: boolean, atraso = 0) {
    const aSair = el.dataset.saindo === '1';
    if (mostrar === (!el.hidden && !aSair)) return;
    el.getAnimations().forEach((a) => a.cancel());
    el.style.overflow = '';
    delete el.dataset.saindo;
    if (!animar || semAnimacao) {
      el.hidden = !mostrar;
      return;
    }
    el.hidden = false;
    if (!mostrar) el.dataset.saindo = '1';
    const gap = parseFloat(getComputedStyle(el.parentElement!).rowGap) || 0;
    const fechado = { height: '0px', opacity: 0, marginTop: `${-gap}px`, transform: 'translateY(-6px)' };
    const aberto = { height: `${el.scrollHeight}px`, opacity: 1, marginTop: '0px', transform: 'none' };
    // Só corta o conteúdo durante a animação (para não cortar contornos de foco depois).
    el.style.overflow = 'hidden';
    const anim = el.animate(mostrar ? [fechado, aberto] : [aberto, fechado], {
      duration: mostrar ? 420 : 300,
      delay: atraso,
      easing: mostrar ? 'cubic-bezier(.2,.75,.25,1)' : 'cubic-bezier(.4,0,.6,1)',
      fill: 'both',
    });
    anim.onfinish = () => {
      if (!mostrar) {
        el.hidden = true;
        delete el.dataset.saindo;
      }
      el.style.overflow = '';
      anim.cancel();
    };
  }

  /** Mostra só o que interessa: acompanhantes escolhidos e o campo "qual?" quando não disse "Não". */
  function atualizar(animar = true) {
    const vai = form.querySelector<HTMLInputElement>('input[name=presenca]:checked')?.value !== 'nao';
    revelar(soSeVai, vai, animar);
    const n = Number(form.querySelector<HTMLInputElement>('input[name=acompanhantes]:checked')?.value ?? 0);
    // Vários de uma vez entram um a seguir ao outro (e saem do último para o primeiro).
    let entra = 0;
    acompBlocos.forEach((bloco) => {
      const ativo = Number(bloco.dataset.acomp) <= n;
      if (ativo && (bloco.hidden || bloco.dataset.saindo)) revelar(bloco, true, animar, 70 * entra++);
      bloco.querySelectorAll('input, select').forEach((el) => ((el as HTMLInputElement).disabled = !ativo));
    });
    const saem = acompBlocos.filter((b) => Number(b.dataset.acomp) > n && !b.hidden && !b.dataset.saindo).reverse();
    saem.forEach((bloco, k) => revelar(bloco, false, animar, 50 * k));
    form.querySelectorAll<HTMLFieldSetElement>('[data-restricao]').forEach((fs) => {
      const nao = fs.querySelector<HTMLInputElement>('input[value=nao]')!.checked;
      revelar(fs.querySelector<HTMLDivElement>('.qual-wrap')!, !nao, animar);
    });
  }
  atualizar(false);

  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    // Escolher "Não" limpa o "qual?" para não ficar texto esquecido.
    if (t.type === 'radio' && t.value === 'nao' && t.name.startsWith('restricao_')) {
      form.querySelector<HTMLInputElement>(`[name=${t.name}_qual]`)!.value = '';
    }
    atualizar();
  });

  // Escrever a restrição já conta como "Sim".
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.classList.contains('qual') || !t.value.trim()) return;
    const sim = form.querySelector<HTMLInputElement>(`[name=${t.name.replace('_qual', '')}][value=sim]`);
    if (sim && !sim.checked) sim.checked = true;
  });

  /** Validação no browser, com as mesmas regras do servidor. */
  function validar(data: FormData): [string, string] | null {
    const nome = String(data.get('nome') ?? '').trim();
    if (nome.length < 2) return ['Escreve o teu nome, por favor.', '#nome'];
    if (!data.get('presenca')) return ['Diz-nos se contamos contigo.', 'input[name=presenca]'];
    if (data.get('presenca') !== 'sim') return null;
    const n = Number(data.get('acompanhantes') ?? 0);
    for (let i = 0; i <= n; i++) {
      const nomeI = i === 0 ? nome : String(data.get(`acomp_${i}_nome`) ?? '').trim();
      if (nomeI.length < 2) return [`Escreve o nome do acompanhante ${i}, por favor.`, `#acomp_${i}_nome`];
      if (i > 0 && !data.get(`acomp_${i}_idade`)) return [`Diz-nos a idade de ${nomeI}, por favor.`, `#acomp_${i}_idade`];
      const respondeu = data.get(`restricao_${i}`) || String(data.get(`restricao_${i}_qual`) ?? '').trim();
      if (!respondeu)
        return [
          i === 0 ? 'Diz-nos se tens alguma restrição alimentar.' : `Diz-nos se ${nomeI} tem alguma restrição alimentar.`,
          `input[name=restricao_${i}]`,
        ];
    }
    return null;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    erro.hidden = true;
    const data = new FormData(form);
    const problema = validar(data);
    if (problema) return mostrarErro(...problema);
    const nome = String(data.get('nome')).trim();
    const pessoas = data.get('presenca') === 'sim' ? 1 + Number(data.get('acompanhantes') ?? 0) : 0;

    botao.disabled = true;
    botao.textContent = 'A enviar…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const body = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        campo?: string;
        fechado?: boolean;
        semAcesso?: boolean;
        alterada?: boolean;
        editar?: string;
      };
      if (body.fechado) return fecharRsvp();
      if (body.semAcesso) return location.assign('/#codigo');
      if (!res.ok || !body.ok) {
        const foco = body.campo
          ? /^(nome|acomp_)/.test(body.campo)
            ? `#${body.campo}`
            : `input[name=${body.campo}]`
          : undefined;
        return mostrarErro(body.error || 'Algo correu mal. Tenta novamente.', foco);
      }
      mostrarObrigado(pessoas > 0, nome, pessoas, !!body.alterada);
      // Nova resposta pelo código: passa a haver um link para a alterar.
      if (body.editar && !cartao.dataset.editar) mostrarLink(body.editar);
      if (body.editar && body.alterada) {
        // Mostra outra vez o link a quem está a alterar pelo link (/r/...), para o terem à mão.
        const a = guardarLink.querySelector<HTMLAnchorElement>('.guardar-link__url')!;
        a.href = a.textContent = body.editar;
        guardarLink.hidden = false;
      }
    } catch {
      mostrarErro('Não foi possível enviar. Verifica a ligação e tenta novamente.');
    } finally {
      botao.disabled = false;
      botao.textContent = cartao.dataset.editar ? 'Guardar alterações' : textoBotao;
    }
  });

  /** O servidor diz que o prazo passou (ex.: relógio do telemóvel atrasado): mostra a mensagem de fecho. */
  function fecharRsvp() {
    document.getElementById('rsvp')!.classList.add('rsvp-fechado');
  }

  function mostrarErro(msg: string, foco?: string) {
    erro.textContent = msg;
    erro.hidden = false;
    if (foco) form.querySelector<HTMLElement>(foco)?.focus();
  }

  obrigado.querySelector('.outra')!.addEventListener('click', () => {
    obrigado.hidden = true;
    guardarLink.hidden = true;
    form.hidden = false;
    if (ola) ola.hidden = false;
    // Numa resposta nova pelo código (sem link de alteração), "Enviar outra resposta" começa do zero.
    if (!cartao.dataset.editar) {
      form.reset();
      atualizar(false);
    }
    form.querySelector<HTMLInputElement>('#nome')!.focus();
  });

  // Sem JavaScript, o servidor redireciona para ...?rsvp=ok|erro|apagada|fechado
  const estado = new URLSearchParams(location.search).get('rsvp');
  if (estado === 'ok') {
    obrigado.querySelector('.obrigado__t')!.textContent = 'Obrigado pela resposta!';
    if (location.pathname.startsWith('/r/')) mostrarLink(location.origin + location.pathname);
    form.hidden = true;
    if (ola) ola.hidden = true;
    if (apagarForm) apagarForm.hidden = true;
    obrigado.hidden = false;
  } else if (estado === 'apagada') {
    obrigado.querySelector('.obrigado__t')!.textContent = 'Resposta apagada';
    obrigado.querySelector('.obrigado__s')!.textContent = 'Se mudares de ideias, podes responder outra vez.';
    obrigado.querySelector('.outra')!.textContent = 'Responder outra vez';
    form.hidden = true;
    obrigado.hidden = false;
  } else if (estado === 'fechado') {
    fecharRsvp();
  } else if (estado === 'erro') {
    mostrarErro('Não foi possível enviar. Confirma se preencheste tudo e tenta novamente.');
  }
  if (estado) history.replaceState(null, '', location.pathname + '#rsvp');
  }

  // Aparecer suave ao fazer scroll
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('anim');
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('visivel');
            io.unobserve(en.target);
          }
        }),
      { rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }
</script>

